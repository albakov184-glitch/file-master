# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-your-token

# Ваш Telegram ID — для команды /stats (узнать: @userinfobot)
ADMIN_IDS=

# Redis для очереди задач (в docker-compose менять не нужно)
REDIS_URL=redis://redis:6379

# Сколько файлов воркер обрабатывает одновременно
WORKER_CONCURRENCY=2
# Максимум задач в работе на одного пользователя
MAX_ACTIVE_JOBS_PER_USER=3
# Языки распознавания текста (Tesseract)
OCR_LANGS=rus+eng
TIMEZONE=Europe/Moscow

# --- Большие файлы до 2 ГБ (необязательно) ---
# Получите api_id и api_hash на https://my.telegram.org и запустите:
#   docker compose --profile bigfiles up -d
# Затем раскомментируйте BOT_API_URL.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# BOT_API_URL=http://telegram-bot-api:8081
